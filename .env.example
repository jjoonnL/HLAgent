# Prefer python configure.py or Web Model settings for hidden key entry.
# CLI options and exported environment variables override this file.
DEFAULT_LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# Select model IDs available to your account.
# OPENAI_MODEL=
# OPENAI_API_KEY=
# ANTHROPIC_MODEL=
# ANTHROPIC_API_KEY=
# GEMINI_MODEL=
# GEMINI_API_KEY=

# Required only for Tutor web and hybrid search.
# TAVILY_API_KEY=

# Optional prepared local embedding snapshot. Never downloaded automatically.
# TUTOR_EMBEDDING_MODEL_DIR=
